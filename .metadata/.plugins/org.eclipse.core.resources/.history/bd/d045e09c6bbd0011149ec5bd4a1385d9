#include "main.h"

void SystemClock_Config(void);
static void MX_GPIO_Init(void);

void delay_us(uint32_t us);

int main(void)
{
    HAL_Init();

    SystemClock_Config();
    MX_GPIO_Init();

    uint8_t brightness = 50;

    uint32_t on_time;
    uint32_t off_time;

    while (1)
    {
        /* ==============================
           INCREASE BRIGHTNESS
           PA5 / D13
           ============================== */

        if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_5) == GPIO_PIN_RESET)
        {
            if (brightness < 100)
            {
                brightness++;
            }

            HAL_Delay(100);
        }


        /* ==============================
           DECREASE BRIGHTNESS
           PB0 / D33
           ============================== */

        if (HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_0) == GPIO_PIN_RESET)
        {
            if (brightness > 0)
            {
                brightness--;
            }

            HAL_Delay(100);
        }


        /* ==============================
           SOFTWARE PWM
           ============================== */

        /*
         * Total PWM period = 1 ms
         * Frequency = 1 kHz
         */

        on_time = brightness * 10;

        off_time = 1000 - on_time;


        /* LED ON */

        if (on_time > 0)
        {
            HAL_GPIO_WritePin(GPIOE,
                              GPIO_PIN_9,
                              GPIO_PIN_SET);

            delay_us(on_time);
        }


        /* LED OFF */

        if (off_time > 0)
        {
            HAL_GPIO_WritePin(GPIOE,
                              GPIO_PIN_9,
                              GPIO_PIN_RESET);

            delay_us(off_time);
        }
    }
}


/* =====================================================
   MICROSECOND DELAY USING DWT
   ===================================================== */

void delay_us(uint32_t us)
{
    uint32_t start = DWT->CYCCNT;

    uint32_t cycles =
        us * (HAL_RCC_GetHCLKFreq() / 1000000);

    while ((DWT->CYCCNT - start) < cycles)
    {
    }
}


