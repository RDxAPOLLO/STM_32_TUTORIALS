/**
  * @brief  The application entry point.
  * @retval int
  */

int main(void)
{
    /* MCU Configuration--------------------------------------------------------*/

    HAL_Init();


    /* Configure the system clock */

    SystemClock_Config();


    /* Initialize all configured peripherals */

    MX_GPIO_Init();


    /* =========================================================
       SOFTWARE PWM VARIABLES

       Total PWM period = 1000 us

       Initially:

       ON  = 500 us
       OFF = 500 us

       Therefore brightness = 50%
       ========================================================= */

    uint32_t on_time = 500;
    uint32_t off_time = 500;

    uint32_t last_button_time = 0;


    while (1)
    {

        /* =====================================================
           INCREASE BRIGHTNESS
           PA5 / D13
           ===================================================== */

        if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_5) == GPIO_PIN_RESET)
        {
            if ((HAL_GetTick() - last_button_time) >= 100)
            {
                if (on_time < 1000)
                {
                    on_time += 200;
                    off_time -= 200;
                }

                last_button_time = HAL_GetTick();
            }
        }


        /* =====================================================
           DECREASE BRIGHTNESS
           PB0 / D33
           ===================================================== */

        if (HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_0) == GPIO_PIN_RESET)
        {
            if ((HAL_GetTick() - last_button_time) >= 100)
            {
                if (on_time >= 200)
                {
                    on_time -= 200;
                    off_time += 200;
                }

                last_button_time = HAL_GetTick();
            }
        }


        /* =====================================================
           SOFTWARE PWM

           ON TIME
           ===================================================== */

        if (on_time > 0)
        {
            HAL_GPIO_WritePin(GPIOE,
                              GPIO_PIN_9,
                              GPIO_PIN_SET);

            delay_us(on_time);
        }


        /* =====================================================
           OFF TIME
           ===================================================== */

        if (off_time > 0)
        {
            HAL_GPIO_WritePin(GPIOE,
                              GPIO_PIN_9,
                              GPIO_PIN_RESET);

            delay_us(off_time);
        }

    }
}


/* =========================================================
   MICROSECOND DELAY

   Uses DWT cycle counter of Cortex-M4
   ========================================================= */

void delay_us(uint32_t us)
{
    uint32_t start = DWT->CYCCNT;

    uint32_t cycles =
        us * (HAL_RCC_GetHCLKFreq() / 1000000U);

    while ((DWT->CYCCNT - start) < cycles)
    {
    }
}


